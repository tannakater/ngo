rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow collection group queries on members for public verification across devices
    match /{path=**}/members/{memberId} {
      allow read, write: if true;
    }

    // Users, system admins, and organization settings
    match /users/{userId} {
      allow read, write: if true;
      match /members/{memberId} {
        allow read, write: if true;
      }
    }
    match /web_users/{id} {
      allow read, write: if true;
    }

    // Top-level collections for Campaigns, Projects, Volunteers, Events, News, Donations, Messages, Documents, and Stats
    match /campaigns/{id} {
      allow read, write: if true;
    }
    match /projects/{id} {
      allow read, write: if true;
    }
    match /volunteers/{id} {
      allow read, write: if true;
    }
    match /public_volunteers/{id} {
      allow read, write: if true;
    }
    match /events/{id} {
      allow read, write: if true;
    }
    match /news/{id} {
      allow read, write: if true;
    }
    match /donations/{id} {
      allow read, write: if true;
    }
    match /messages/{id} {
      allow read, write: if true;
    }
    match /documents/{id} {
      allow read, write: if true;
    }
    match /audit_logs/{id} {
      allow read, write: if true;
    }
    match /app_stats/{id} {
      allow read, write: if true;
    }

    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
