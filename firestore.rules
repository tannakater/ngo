rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow collection group queries on members for public verification
    match /{path=**}/members/{memberId} {
      allow read: if true;
    }

    // Users and organization settings
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /members/{memberId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Separate top-level collections for Campaigns, Projects, Volunteers, Events, News, Donations, Messages, Documents, and Stats
    match /campaigns/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /volunteers/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /events/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /news/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /donations/{id} {
      allow read: if true;
      allow update, delete: if request.auth != null;
      allow create: if true;
    }
    match /public_volunteers/{id} {
      allow read: if true;
      allow update, delete: if request.auth != null;
      allow create: if true;
    }
    match /messages/{id} {
      allow read, write: if request.auth != null;
    }
    match /documents/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /audit_logs/{id} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    match /app_stats/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
