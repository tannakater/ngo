rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Admin check - only authenticated users of the NGO portal can access administrative areas
    function isAdmin() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && request.auth.uid == userId;
      
      match /members/{memberId} {
        allow read, write: if isAdmin();
      }
    }
    
    // Public read for programs
    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Public read for campaigns
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Donations: public can create (submit form), but only admins can read/update/delete
    match /donations/{donationId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }

    // Volunteer Requests: public can create, but only admins can read/update/delete
    match /public_volunteers/{volunteerId} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }
  }
}
